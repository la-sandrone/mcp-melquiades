# ── 凭据：永不入库 ─────────────────────────────────────────────────
# config.yaml 含真实 DB 口令，是本地运行时配置；公开仓只收 config.example.yaml。
config.yaml
.env
.env.*
!.env.example
*.key
*.pem

# ── 运行产物 / 缓存 ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.log
.venv/
venv/
.pytest_cache/
.cache/

# ── 备份与导出行（本项目惯例：就地 .bak-<后缀>）─────────────────────
# 改动前的备份/导出行（回填脚本、rename 脚本的产物）——是本地产物，不入库。
_backup/
*.bak
*.bak-*
*.bak-d[0-9]*

# ── 测量 / 回放输出 ────────────────────────────────────────────────
tools/replay/out/

# ── 测试生成物（会话日志 fixture 在测试时由 JSONL 合成，不入库）──────
tests/fixtures/_generated/

# ── 编辑器 / 系统 ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
