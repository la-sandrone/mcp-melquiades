{
  "name": "dsh-omnibus-search",
  "description": "DSH web plugin: unified search over the melquiades ledger (draftpad / session messages / compaction summaries) — forwards to a local HTTP bridge and shows results in a sidebar tab",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "search",
    "melquiades",
    "omnibus"
  ]
}
